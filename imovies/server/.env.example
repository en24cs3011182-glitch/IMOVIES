PORT=5000
NODE_ENV=development
MONGO_URI=replace-with-your-mongodb-connection-string
# The second entry is the Network address Vite prints; replace this sample IP.
CLIENT_URL=http://localhost:5175,http://192.168.0.0:5175
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
SEAT_HOLD_MINS=5
CANCEL_CUTOFF_MINS=120
SEAT_PRICE_REGULAR=100
SEAT_PRICE_PREMIUM=150
SEED_ADMIN_EMAIL=replace-with-admin-email@example.test
SEED_ADMIN_NAME=replace-with-admin-name
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
